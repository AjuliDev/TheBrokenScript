Configs: {
	ClientConfig: {
		DisplayName: Client Config
		Headers.Rendering: RENDERING FEATURES

		ShowCorruptionVisionAssist: {
			Label: Corruption Vision Assist
			Tooltip: Display a helper in dark surface areas to help in viewing entities. WARNING: Disabling this WILL affect your gameplay experience!
		}

		CorruptionVisionAssistHeight: {
			Label: Corruption Vision Assist Height
			Tooltip: Adjust the height at which to render the helper, relative to the median world surface.
		}

		PosterizationShader: {
			Label: Corrupted Shader
			Tooltip: Enable or disable the Corrupted Shader. WARNING: Disabling this WILL affect your gameplay experience!
		}

		TileAmbientParticles: {
			Label: Tile Ambient Particles
			Tooltip: Enable or disable the ambient particles that some tiles have. WARNING: Disabling this WILL affect your gameplay experience!
		}
	}

	ServerConfig: {
		DisplayName: Server Config

		MinimumRandomEventCooldown: {
			Label: Minimum Random Event Cooldown
			Tooltip: ""
		}

		Headers: {
			Awakening: AWAKENING SETTINGS
			Events: EVENTS
			Entities: ENTITIES AND APPARITIONS
			Rendering: RENDERING FEATURES
		}

		BossToDefeat: {
			Label: Corruption Trigger Boss
			Tooltip: This boss is what will trigger the awakening (w.i.p) in the mod, as well as the corruption of the world.
		}

		NightsUntilMoonCorruption: {
			Label: Nights Until Corrupted Moons
			Tooltip: The minimum amount of nights to pass until corrupted moons can occur.
		}

		ReviewMode: {
			Label: Mod Review Mode / Skip Boss Trigger
			Tooltip: Enable this if you want the mod to start right away, without waiting for the Corruption Trigger Boss to die.
		}

